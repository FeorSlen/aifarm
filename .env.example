RABBITMQ_USER=aifarm
RABBITMQ_PASSWORD=change-me-before-sharing
WORKER_ID=worker1
GOOGLE_HEADLESS=false

# Общий MCP-арендатор (namespace) для клиентов без заголовка X-Aifarm-User.
# Пусто — генерится разовый uuid4 на запуск процесса (сбрасывается при рестарте).
# Задайте фиксированный uuid4 (именно uuid4, иначе шлюз не стартует), чтобы
# вкладки переживали рестарт шлюза.
AIFARM_USER_ID=

# Каталог для дампа ответа AI Mode (html + raw + clean) — разовая диагностика денойза.
# Должен быть writable для uid 10001 внутри контейнера (том browser-profiles подходит).
# AIFARM_DUMP_ANSWER=/data/profiles/answer_dump

# Публичный порт на VPS (только за файрволом — аутентификации у MCP-сервера нет):
# GATEWAY_BIND=0.0.0.0:8000
# AIFARM_MCP_HOST=0.0.0.0        # выключает DNS-rebinding guard, иначе внешний Host = 403

# Sticky-резидентный прокси для воркера (без него Google банит IP датацентра).
# Формат: http://логин:пароль@host:port  (Astroproxy: node-xx-NN.astroproxy.com:PORT)
# PROXY_URL=http://DaneQ4:0eff83yG8@node-de-94.astroproxy.com:10042

